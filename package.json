{
  "name": "ask-insurance",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "web",
    "admin",
    "shared",
    "api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:api": "npm run dev --workspace=api",
    "dev:mobile": "cd mobile && npx expo start --clear",
    "dev": "npm run dev:web",
    "dev:all": "concurrently --kill-others \"npm run dev:web\" \"npm run dev:admin\" \"npm run dev:api\"",
    "kill:dev": "pkill -f 'tsx watch' && pkill -f 'next dev' && pkill -f 'next-server'",
    "build:web": "npm run build --workspace=web",
    "build:admin": "npm run build --workspace=admin",
    "build:api": "npm run build --workspace=api",
    "build:all": "npm run build --workspace=web && npm run build --workspace=admin",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "rm -rf node_modules mobile/node_modules admin/.next web/.next mobile/.expo mobile/android/.gradle mobile/android/build mobile/android/app/build mobile/ios/build mobile/ios/Pods dist api/dist"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "prisma": {
      "@prisma/config": {
        "deepmerge-ts": "8.0.2"
      }
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "image-size": "1.2.1",
    "image-size": "^2.0.2",
    "mariadb": "^3.4.6",
    "nanoid": "^5.1.3",
    "postcss": "^8.5.3",
    "brace-expansion": "1.1.18",
    "sharp": "^0.35.0",
    "uuid": "^11.1.1",
    "eslint": "^9.21.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.2.2",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
