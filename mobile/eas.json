{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_NO_CI": "1"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ask-insurance.onrender.com",
        "EAS_NO_CI": "1"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ask-insurance.onrender.com",
        "EAS_NO_CI": "1"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ask-insurance.onrender.com",
        "EAS_NO_CI": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}