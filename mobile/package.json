{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:clean": "rm -rf android/app/build android/app/.cxx android/.gradle && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "eas:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "eas:android:preview:local": "GOOGLE_SERVICES_JSON=\"$(pwd)/google-services.json\" npx eas-cli@latest build --platform android --profile preview --local",
    "eas:ios:preview:local": "GOOGLE_SERVICES_PLIST=\"$(pwd)/GoogleService-Info.plist\" npx eas-cli@latest build --platform ios --profile preview --local"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "expo": "^56.0.0",
    "expo-adi-registration": "^1.0.0",
    "expo-build-properties": "~56.0.23",
    "expo-constants": "~56.0.21",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.15",
    "expo-notifications": "~56.0.21",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.5": true
  }
}
