{
  "expo": {
    "name": "ASK Insurance",
    "slug": "ask-insurance",
    "version": "1.3.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "askinsurance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ask.insurance",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.ask.insurance"
        ]
      }
    },
    "android": {
      "versionCode": 6,
      "icon": "./assets/images/playstore.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/playstore.png",
        "backgroundColor": "#E6F4FE"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.ask.insurance",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1628",
          "image": "./assets/images/logo-glow.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0A1628",
            "image": "./assets/images/logo-glow.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "../icons/appstore.png",
          "color": "#208AEF",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "ndkVersion": "27.0.12077973",
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "# --- Keep rules for reflection-based native libs (R8 obfuscation) ---\n# React Native / Hermes / JNI\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep,allowobfuscation @interface com.facebook.proguard.annotations.DoNotStrip\n-keep @com.facebook.proguard.annotations.DoNotStrip class * { *; }\n-keepclassmembers class * { @com.facebook.proguard.annotations.DoNotStrip *; }\n-keepclassmembers class * { @com.facebook.react.bridge.ReactMethod *; }\n# Reanimated\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n# Expo modules (heavy reflection / Kotlin)\n-keep class expo.modules.** { *; }\n-keep class versioned.host.exp.exponent.** { *; }\n# Firebase\n-keep class com.google.firebase.** { *; }\n-keep class io.invertase.firebase.** { *; }\n-dontwarn com.google.firebase.**\n# Keep annotations / generic signatures used by JSON/reflection\n-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-adi-registration",
      "./plugins/withFirebaseNonModularHeaders"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c033321-0330-420f-bc8f-793952ac9ec6"
      }
    }
  }
}
