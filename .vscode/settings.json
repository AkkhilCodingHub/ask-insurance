{
  "files.watcherExclude": {
    "**/.git": true,
    "**/.git/**": true,
    "**/.git/index": true,
    "**/.git/index.lock": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/release/**": true,
    "**/mobile/android/**": true,
    "**/mobile/ios/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/release": true
  },
  "git.refreshOnFocus": false,
  "git.autoStash": false,
  "git.showProgress": false,
  "git.decorations.enabled": true
}
