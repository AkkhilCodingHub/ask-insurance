// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String    @id @default(cuid())
  customerCode String?   @unique
  phone        String    @unique
  email        String?   @unique
  name        String?
  dateOfBirth DateTime?
  gender      String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  pushToken   String?   // Expo push token

  // KYC
  kycStatus          String    @default("pending") // pending | submitted | verified | rejected
  digilockerSub      String?   @unique             // DigiLocker unique user ID
  aadhaarVerified    Boolean   @default(false)
  panNumber          String?
  kycDocuments       Json?                          // raw DigiLocker issued-files metadata
  kycVerifiedAt      DateTime?
  // Manual KYC upload
  kycDocType         String?   // aadhaar | driving_license | passport
  kycDocUrl          String?   // R2 public URL of uploaded document
  kycRejectionReason String?
  kycSubmittedAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  policies      Policy[]
  claims        Claim[]
  quotes        Quote[]
  otpChallenges OtpChallenge[]
  payments      Payment[]
  notifications Notification[]
  conversations Conversation[]
  userDocuments UserDocument[]
  vehicles      Vehicle[]
  endorsements  Endorsement[]

  // Agent Assignment
  agentId     String?
  agent       Admin?         @relation("AgentCustomers", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([email])
  @@map("users")
}

model Insurer {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  shortName    String
  logo         String // absolute URL
  brandColor   String // hex e.g. #FF6600
  tagline      String?
  founded      Int?
  headquarters String?
  website      String?
  claimsRatio  Float // percentage e.g. 98.5
  rating       Float // out of 5
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plans    Plan[]
  policies Policy[]
  brokerageSlabs BrokerageSlab[]
  rateCharts     PremiumRateChart[]

  @@index([isActive])
  @@index([createdAt])
  @@map("insurers")
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String // life, health, motor, travel, home, business
  description String   @db.Text
  features    String   @db.Text // JSON string[]
  minAge      Int?
  maxAge      Int?
  minCover    Float
  maxCover    Float
  basePremium Float // annual base premium in INR
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  insurerId String
  insurer   Insurer  @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  policies  Policy[]

  @@index([insurerId])
  @@index([isActive])
  @@index([createdAt])
  @@map("plans")
}

model Policy {
  id            String    @id @default(cuid())
  policyNumber  String    @unique
  type          String // life, health, motor, travel, home, business
  provider      String // insurer name (denormalised for easy reads)
  sumInsured    Float
  premium       Float
  startDate     DateTime
  endDate       DateTime
  status        String    @default("active") // pending, active, expired, cancelled
  paymentStatus String    @default("pending") // pending, paid, failed
  cancelledAt   DateTime?
  documentUrl   String?   // URL to uploaded policy PDF
  registrationNumber String? // e.g. DL-01-AB-1234
  notes         String?   @db.Text // admin notes visible to customer
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Brokerage Tracking
  brokerageRate   Float?
  brokerageAmount Float?
  brokerageStatus String    @default("pending") // pending, paid
  brokeragePaidAt DateTime?

  // Relations
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteId   String?
  quote     Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  insurerId String?
  insurer   Insurer?  @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  planId    String?
  plan      Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  vehicleId String?
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  claims        Claim[]
  payments      Payment[]
  renewal       Renewal?
  endorsements  Endorsement[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([registrationNumber])
  @@index([insurerId])
  @@index([planId])
  @@index([userId, paymentStatus])
  @@index([status])
  @@map("policies")
}

model Claim {
  id            String    @id @default(cuid())
  claimNumber   String    @unique
  type          String // medical, accident, theft, etc.
  amount        Float
  status        String    @default("pending") // pending, approved, rejected, paid, settled
  description   String?
  incidentDate  DateTime
  submittedDate DateTime  @default(now())
  approvedDate  DateTime?
  paidDate      DateTime?
  documents     String? // JSON array of document URLs
  notes         String? // admin notes
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([policyId])
  @@index([status])
  @@map("claims")
}

model Quote {
  id              String    @id @default(cuid())
  type            String
  details         String    @db.Text  // JSON: user requirements (age, cover, etc.)
  providers       String    @db.Text  // JSON: kept for legacy, empty for new flow
  registrationNumber String? // e.g. DL-01-AB-1234
  status          String    @default("pending") // pending, responded, approved, converted, expired
  stage           String    @default("new")     // new, quotation_sent, in_discussion, closed, lost
  // Admin's actual quote response
  adminResponse   String?   @db.Text  // JSON: { insurer, planName, netPremium, gst, totalPremium, notes }
  adminResponseAt DateTime?
  approvedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Admin?    @relation("AgentQuotes", fields: [agentId], references: [id], onDelete: SetNull)
  vehicleId String?
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  policies  Policy[]

  @@index([userId, status])
  @@index([userId, expiresAt])
  @@index([userId, createdAt])
  @@index([registrationNumber])
  @@index([status, expiresAt])
  @@index([agentId])
  @@map("quotes")
}

model Vehicle {
  id                 String   @id @default(cuid())
  registrationNumber String   @unique // primary lookup key e.g. DL-01-AB-1234
  vehicleType        String   // car, two_wheeler, commercial
  make               String?  // e.g. Maruti Suzuki, Honda, Tata
  model              String?  // e.g. Swift, City, Ace
  variant            String?  // e.g. VXi, ZX
  registrationYear   Int?     // e.g. 2021
  fuelType           String?  // petrol, diesel, cng, electric
  engineNumber       String?
  chassisNumber      String?
  ncbPercentage      Float?   @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policies Policy[]
  quotes   Quote[]

  @@index([userId])
  @@index([registrationNumber])
  @@map("vehicles")
}

model Payment {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("INR")
  status      String   @default("pending") // pending, success, failed, refunded
  provider    String? // razorpay, stripe, etc.
  providerRef String? // external payment ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([policyId, status])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Notification {
  id        String    @id @default(cuid())
  type      String // claim_update, policy_expiry, payment_due, general
  title     String
  body      String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Admin {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String?  // null for Google-only admins
  googleId    String?  @unique
  name        String
  role        String   @default("admin") // admin, superadmin, agent
  isActive    Boolean  @default(true)
  agentCode   String?  @unique // e.g. AGT-1082 for QR code scanning
  storageUsed BigInt   @default(0) // bytes used out of 10 GB quota
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Agent KYC & DigiLocker Storage
  kycStatus          String    @default("pending") // pending | submitted | verified | rejected
  digilockerSub      String?   @unique
  kycDocType         String?   // aadhaar | driving_license | passport
  kycDocUrl          String?   // R2 public URL
  kycDocuments       Json?     // raw DigiLocker issued-files metadata
  kycRejectionReason String?
  kycSubmittedAt     DateTime?
  kycVerifiedAt      DateTime?

  // Agent Settings / Assignments
  assignedInsurers       Json? // JSON array of Insurer IDs
  assignedInsuranceTypes Json? // JSON array of plan types (e.g. ["life", "health"])

  conversations  Conversation[]
  files          AdminFile[]
  userDocuments  UserDocument[]
  addedUsers     User[]         @relation("AgentCustomers")
  assignedQuotes Quote[]        @relation("AgentQuotes")
  activityLogs   ActivityLog[]
  renewals       Renewal[]

  @@index([isActive])
  @@index([createdAt])
  @@map("admins")
}

model AdminFile {
  id        String   @id @default(cuid())
  name      String   // original filename shown in UI
  key       String   // R2 object key
  url       String   // public CDN URL
  size      BigInt   // bytes
  mimeType  String
  createdAt DateTime @default(now())

  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([adminId, createdAt])
  @@map("admin_files")
}

model Conversation {
  id        String   @id @default(cuid())
  subject   String?
  status    String   @default("open") // open, closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId String?
  admin   Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  content        String   @db.Text
  senderType     String   // "user" | "admin"
  senderId       String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  otpHash    String
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, expiresAt])
  @@index([phone, consumedAt])
  @@index([userId])
  @@map("otp_challenges")
}

model BrokerageSlab {
  id            String   @id @default(cuid())
  insurerId     String
  insurer       Insurer  @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  insuranceType String   // life, health, motor, travel, home, business
  percentage    Float    // e.g. 15.5 for 15.5%
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([insurerId, insuranceType])
  @@map("brokerage_slabs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  details   String   @db.Text
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@map("activity_logs")
}

model QuotationTemplate {
  id                 String   @id @default(cuid())
  name               String
  type               String   // life, health, motor, travel, home, business
  subject            String?
  headerText         String?  @db.Text
  footerText         String?  @db.Text
  termsAndConditions String?  @db.Text
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@map("quotation_templates")
}

model PremiumRateChart {
  id            String   @id @default(cuid())
  insurerId     String
  insurer       Insurer  @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  insuranceType String   // life, health, motor, travel, home, business
  minAge        Int?
  maxAge        Int?
  baseRate      Float    // flat premium amount or percentage of sumInsured
  rateType      String   @default("flat") // flat, percentage_of_sum_insured
  gstPercentage Float    @default(18.0)
  createdAt     DateTime @default(now())

  @@index([insurerId])
  @@map("premium_rate_charts")
}

model Renewal {
  id         String    @id @default(cuid())
  policyId   String    @unique
  policy     Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Admin?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status     String    @default("pending") // pending, contacted, closed, lost
  notes      String?   @db.Text
  assignedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([agentId])
  @@index([status])
  @@map("renewals")
}

model CommunicationTemplate {
  id        String   @id @default(cuid())
  name      String
  channel   String   // sms, email, push
  trigger   String   @unique // policy_expiry, quote_approved, claim_update
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("communication_templates")
}

model UserDocument {
  id            String   @id @default(cuid())
  title         String
  docType       String   // aadhaar, pan, driving_license, vehicle_rc, policy, custom
  source        String   // digilocker | user_upload
  fileUrl       String?  // R2 public URL
  fileKey       String?  // R2 object key
  mimeType      String?
  fileSize      BigInt?
  digilockerUri String?  // DigiLocker document URI e.g. in.gov.uidai-adhaar-...
  issuer        String?
  issueDate     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId       String?
  admin         Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
  @@index([source])
  @@map("user_documents")
}

model Endorsement {
  id                 String   @id @default(cuid())
  endorsementNumber  String   @unique
  type               String   @default("non_financial") // financial | non_financial
  category           String   // name_correction | address_update | nominee_change | vehicle_reg_update | sum_insured_change | custom
  requestedChanges   String   @db.Text
  status             String   @default("pending") // pending | approved | rejected | processed
  adminNotes         String?  @db.Text
  revisedDocumentUrl String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  policyId           String
  policy             Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([userId])
  @@index([status])
  @@map("endorsements")
}

model PospExamAttempt {
  id               String   @id @default(cuid())
  candidateName    String
  candidatePhone   String
  candidateEmail   String
  score            Int
  totalQuestions   Int      @default(50)
  correctAnswers   Int
  wrongAnswers     Int
  passed           Boolean
  terminatedEarly Boolean  @default(false)
  terminationReason String?
  attemptDate      String   // YYYY-MM-DD for tracking retake limits (max 4 per day)
  startedAt        DateTime
  completedAt      DateTime @default(now())

  createdAt        DateTime @default(now())

  @@index([candidatePhone, attemptDate])
  @@index([candidateEmail, attemptDate])
  @@index([candidatePhone, completedAt])
  @@index([passed])
  @@map("posp_exam_attempts")
}

model PospApplication {
  id                 String   @id @default(cuid())
  applicationNumber  String   @unique // e.g. POSP-REQ-849102
  name               String
  email              String   @unique
  phone              String   @unique
  examScore          Int
  examPassedAt       DateTime
  examAttemptId      String?
  aadhaarNumber      String?
  aadhaarDocUrl      String?  @db.Text
  panNumber          String?
  panDocUrl          String?  @db.Text
  status             String   @default("pending") // pending | approved | rejected
  rejectionReason    String?  @db.Text
  assignedAgentCode  String?
  createdAdminId     String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@index([email])
  @@map("posp_applications")
}
